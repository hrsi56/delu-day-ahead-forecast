        },
        "wall_seconds": {
         "const": 900
        }
       },
       "required": [
        "wall_seconds",
        "peak_bytes"
       ],
       "type": "object"
      },
      "peak_bytes": {
       "maximum": 4294967296,
       "minimum": 0,
       "type": "integer"
      },
      "wall_seconds": {
       "maximum": 900,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "wall_seconds",
      "peak_bytes",
      "limits"
     ],
     "type": "object"
    },
    {
     "type": "null"
    }
   ]
  },
  "route": {
