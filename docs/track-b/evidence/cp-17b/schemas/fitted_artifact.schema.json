      "canonical_hours",
      "missing_hours"
     ],
     "type": "object"
    },
    {
     "type": "null"
    }
   ]
  },
  "product": {
   "const": "delu-day-ahead-policy"
  },
  "quantiles": {
   "anyOf": [
    {
     "items": {
      "items": {
       "type": "number"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
     },
     "maxItems": 25,
     "minItems": 1,
     "type": "array"
    },
    {
     "type": "null"
    }
   ]
  },
  "resources": {
   "anyOf": [
    {
     "properties": {
      "limits": {
       "additionalProperties": false,
       "properties": {
        "peak_bytes": {
