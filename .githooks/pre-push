#!/bin/sh
# Runs the credential-value guard (AGENTS.md § Credentials), then the publication guard
# (Publication Standard v1 §9). Enabled with:
#   git config core.hooksPath <this directory, absolute>
# Both fail closed: a push is refused when either guard cannot run or finds a problem. The secret
# guard always runs first; the publication guard runs only after it has passed.
root="$(cd "$(dirname "$0")/.." && pwd)"
guard="$root/scripts/secret_guard.py"
publication="$root/scripts/publication_guard.py"
python=""
for py in python3 /usr/bin/python3; do
  if command -v "$py" >/dev/null 2>&1; then
    python="$py"
    break
  fi
done
if [ -z "$python" ]; then
  echo "secret-guard: python3 not found; refusing to proceed unchecked (AGENTS.md § Credentials)" >&2
  exit 1
fi
# Git gives a pre-push hook the refs being pushed on stdin; both guards read the same lines.
refs="$(cat)" || exit 1
printf '%s\n' "$refs" | "$python" "$guard" "$(basename "$0")" "$@" || exit 1
if [ ! -f "$publication" ]; then
  echo "publication-guard: $publication is missing; refusing to push unchecked (Publication Standard v1 §9)" >&2
  exit 1
fi
printf '%s\n' "$refs" | "$python" "$publication" pre-push "$@" || exit 1
exit 0
