+        assert S.identity_status(job['child_identity']) == 'same'
+        os.kill(job['child_identity']['pid'], signal.SIGKILL)
+        wait_until(lambda: S.identity_status(job['child_identity']) != 'same')
+        with pytest.raises(RuntimeError, match='runtime is uncertain'):
