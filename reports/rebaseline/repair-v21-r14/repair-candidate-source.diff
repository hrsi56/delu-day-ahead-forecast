+def wait_until(predicate, timeout=12):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        result = predicate()
+        if result:
+            return result
+        time.sleep(0.025)
+    raise AssertionError('monitored test process did not reach its expected state')
