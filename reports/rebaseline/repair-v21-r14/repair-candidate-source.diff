+        signal.signal(sig, lambda signum, frame: interrupted.append(signum))
+    child = None
+    child_identity = None
+    pgid = None
+    known = {}
+    peak = 0
+    code = 70
+    reason = None
+    stopped = False
+    caffeinate = None
